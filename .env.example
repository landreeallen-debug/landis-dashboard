# Copy to .env.local for local dev. Never commit the real values.

# --- Canvas (real data mode only) ---
CANVAS_API_URL=https://your-school.instructure.com/api/v1
CANVAS_API_TOKEN=

# --- AI study guides (optional) ---
ANTHROPIC_API_KEY=

# --- Access control ---
# APP_MODE=sample   → serves fixture data only (safe to leave publicly reachable, no password).
# APP_MODE=live     → serves real Canvas data (this is the default if APP_MODE is unset).
#                      Requires SITE_PASSWORD below; the site returns 503 until it's set.
APP_MODE=live

# Shared password required (HTTP Basic Auth) to view the live-mode site.
# Required whenever APP_MODE=live. Leave unset only when APP_MODE=sample.
SITE_PASSWORD=
